{
 "format": "khg-scenario/1.0.0",
 "id": "S-KEY-006",
 "title": "a non-temporal key collides whatever the dates",
 "requires": [
  "key_constraint"
 ],
 "schema": "fixture.relation-schema.json",
 "fixture": "fixture.c1.json",
 "given": [
  {
   "put": [
    "@entities",
    "@f:born-skłodowska-warszawa"
   ]
  }
 ],
 "when": [
  {
   "op": "put",
   "args": {
    "records": [
     {
      "@": "f:born-skłodowska-kraków",
      "set": {
       "status": "asserted"
      },
      "drop": [
       "status_ref"
      ]
     }
    ]
   },
   "then": {
    "error": "KHG-D016",
    "info": {
     "collisions": [
      {
       "record": "f:born-skłodowska-kraków",
       "policy": "dispute",
       "conflicts": [
        {
         "id": "f:born-skłodowska-warszawa",
         "in_batch": false,
         "shape": null,
         "class": "distinct",
         "action": "dispute"
        }
       ]
      }
     ]
    }
   }
  }
 ],
 "precedent": [
  "B S046",
  "C S-KEY-004"
 ]
}
