{
 "kind": "relation-schema",
 "format": "khg-relation-schema/1.0.0",
 "id": "p2-cyclic",
 "version": "1.0.0",
 "label": "A constructed cyclic schema: three relations whose role sets form a triangle",
 "entity_types": [
  {"id": "Agent"}
 ],
 "roles": [
  {"id": "buyer"},
  {"id": "seller"},
  {"id": "broker"}
 ],
 "relations": [
  {"id": "sale", "roles": [{"role": "buyer", "slot": "core", "fillers": [{"entity": ["Agent"]}], "min": 1, "max": 1}, {"role": "seller", "slot": "core", "fillers": [{"entity": ["Agent"]}], "min": 1, "max": 1}]},
  {"id": "brokerage", "roles": [{"role": "seller", "slot": "core", "fillers": [{"entity": ["Agent"]}], "min": 1, "max": 1}, {"role": "broker", "slot": "core", "fillers": [{"entity": ["Agent"]}], "min": 1, "max": 1}]},
  {"id": "referral", "roles": [{"role": "broker", "slot": "core", "fillers": [{"entity": ["Agent"]}], "min": 1, "max": 1}, {"role": "buyer", "slot": "core", "fillers": [{"entity": ["Agent"]}], "min": 1, "max": 1}]}
 ]
}
