{
  "metadata": {
    "title": "Sample knowledge hypergraph in HIF (Hypergraph Interchange Format)",
    "description": "Three n-ary facts from a toy biomedical knowledge base. Each hyperedge is one fact; each incidence carries the role the entity plays in that fact. Directed: 'tail' incidences are the inputs/subjects of the relation, 'head' incidences are the outputs/objects.",
    "schema": "https://raw.githubusercontent.com/pszufe/HIF-standard/main/schemas/hif_schema.json",
    "created": "2026-09-19",
    "kb-section": "kb/04-storage-and-formats",
    "conventions": {
      "edge.attrs.relation": "the relation (predicate) type of the n-ary fact",
      "incidence.attrs.role": "the role the node plays in the fact (qualifier-style roles allowed)",
      "edge.attrs.source": "provenance pointer for the fact",
      "edge.attrs.valid-from": "ISO-8601 date the fact became valid"
    }
  },
  "network-type": "undirected",
