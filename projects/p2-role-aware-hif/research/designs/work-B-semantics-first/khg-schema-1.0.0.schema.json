{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tag:khg-contracts,2026:schema/khg-schema/1.0.0",
  "title": "KHG relation-type schema document, language khg-schema/1.0.0 (structural layer)",
  "type": "object",
  "required": [
    "khg_schema",
    "id",
    "version",
    "roles",
    "relations"
  ],
  "additionalProperties": false,
  "properties": {
    "khg_schema": {
      "const": "khg-schema/1.0.0"
    },
    "id": {
      "$ref": "#/definitions/vocab_id"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "x-khg-code": "KHG-M004"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "entity_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/vocab_id"
          },
          "label": {
            "type": "string"
          },
          "parents": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/vocab_id"
            },
            "uniqueItems": true
          },
          "mappings": {
            "$ref": "#/definitions/mappings"
          }
        }
      }
    },
    "confidence_scales": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/vocab_id"
          },
          "kind": {
            "enum": [
              "probability",
              "bounded",
              "ordinal"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/vocab_id"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mappings": {
            "$ref": "#/definitions/mappings"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relation"
      }
    }
  },
  "definitions": {
    "vocab_id": {
      "type": "string",
      "pattern": "^[^\\s\\x00-\\x1f\\x7f/]{1,256}$"
    },
    "mappings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "filler": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "entity",
          "literal",
          "fact",
          "precision_min",
          "units"
        ]
      },
      "anyOf": [
        {
          "required": [
            "entity"
          ]
        },
        {
          "required": [
            "literal"
          ]
        },
        {
          "required": [
            "fact"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "entity"
            ]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "entity": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/vocab_id"
                },
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "literal"
            ]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "literal": {
                "enum": [
                  "time",
                  "quantity",
                  "string",
                  "lang_string",
                  "boolean",
                  "iri",
                  "geo"
                ],
                "x-khg-code": "KHG-M006"
              },
              "precision_min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 14
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "fact"
            ]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "fact": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/vocab_id"
                },
                "uniqueItems": true
              }
            }
          }
        }
      ]
    },
    "usage": {
      "type": "object",
      "required": [
        "role",
        "slot",
        "fillers",
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/definitions/vocab_id"
        },
        "slot": {
          "enum": [
            "core",
            "qualifier",
            "time",
            "meta"
          ]
        },
        "fillers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/filler"
          },
          "minItems": 1
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "ordered": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "direction": {
          "enum": [
            "tail",
            "head"
          ]
        },
        "somevalue": {
          "type": "boolean"
        },
        "novalue": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            },
            "required": [
              "complete"
            ]
          },
          "then": {
            "properties": {
              "min": {
                "minimum": 1
              }
            },
            "x-khg-code": "KHG-M014"
          }
        },
        {
          "if": {
            "properties": {
              "slot": {
                "const": "time"
              }
            }
          },
          "then": {
            "properties": {
              "max": {
                "const": 1
              },
              "fillers": {
                "maxItems": 1,
                "items": {
                  "required": [
                    "literal"
                  ],
                  "properties": {
                    "literal": {
                      "const": "time"
                    }
                  }
                }
              }
            },
            "x-khg-code": "KHG-M007"
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "must_differ",
            "must_agree",
            "excludes",
            "at_least_one_of",
            "requires"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "requires"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "if",
              "then"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {},
              "if": {
                "$ref": "#/definitions/vocab_id"
              },
              "then": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/vocab_id"
                },
                "minItems": 1
              },
              "severity": {
                "enum": [
                  "violation",
                  "warning"
                ]
              }
            }
          },
          "else": {
            "required": [
              "roles"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {},
              "roles": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/vocab_id"
                },
                "minItems": 2,
                "uniqueItems": true
              },
              "severity": {
                "enum": [
                  "violation",
                  "warning"
                ]
              }
            }
          }
        }
      ]
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "roles"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/vocab_id"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "fact",
            "rule"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/usage"
          },
          "minItems": 1,
          "x-khg-code": {
            "minItems": "KHG-M001"
          }
        },
        "primary": {
          "type": "object",
          "required": [
            "subject",
            "object"
          ],
          "additionalProperties": false,
          "properties": {
            "subject": {
              "$ref": "#/definitions/vocab_id"
            },
            "object": {
              "$ref": "#/definitions/vocab_id"
            }
          }
        },
        "time": {
          "type": "object",
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "enum": [
                "interval",
                "invariant",
                "unstated"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "model": {
                    "const": "interval"
                  }
                },
                "required": [
                  "model"
                ]
              },
              "then": {
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false,
                "properties": {
                  "model": {},
                  "start": {
                    "$ref": "#/definitions/vocab_id"
                  },
                  "end": {
                    "$ref": "#/definitions/vocab_id"
                  }
                }
              },
              "else": {
                "additionalProperties": false,
                "properties": {
                  "model": {}
                }
              }
            }
          ],
          "x-khg-code": "KHG-M007"
        },
        "key": {
          "type": "object",
          "required": [
            "roles",
            "temporal",
            "on_collision"
          ],
          "additionalProperties": false,
          "properties": {
            "roles": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/vocab_id"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "temporal": {
              "type": "boolean"
            },
            "on_collision": {
              "enum": [
                "close_older",
                "supersede",
                "dispute",
                "reject"
              ]
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/constraint"
          }
        },
        "mappings": {
          "$ref": "#/definitions/mappings"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
