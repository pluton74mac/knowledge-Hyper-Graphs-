{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:khg:schema:khg-hif:1.0.0",
  "title": "khg-hif/1.0.0: the KHG profile of HIF (profile-valid implies HIF-valid)",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/pszufe/HIF_validators/main/schemas/hif_schema_v0.1.0.json"
    },
    {
      "type": "object",
      "required": [
        "network-type",
        "metadata",
        "incidences",
        "nodes",
        "edges"
      ],
      "properties": {
        "network-type": {
          "enum": [
            "directed",
            "undirected"
          ],
          "x-khg-code": "P-NETWORK-TYPE"
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        },
        "incidences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/incidence"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/edge"
          }
        }
      },
      "if": {
        "properties": {
          "network-type": {
            "const": "directed"
          }
        }
      },
      "then": {
        "properties": {
          "incidences": {
            "items": {
              "required": [
                "direction"
              ],
              "x-khg-code": "P-DIRECTED-NO-DIRECTION"
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "khgid": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}:[^\\s<>\"{}|\\\\^`\\u0000-\\u001f\\u007f]{1,256}$",
      "x-khg-code": "P-ID"
    },
    "metadata": {
      "type": "object",
      "required": [
        "roles-convention",
        "hif-schema",
        "hif-schema-sha256",
        "khg-profile",
        "khg-header",
        "khg-schemas"
      ],
      "properties": {
        "roles-convention": {
          "type": "string",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "x-khg-code": "P-CONVENTION"
        },
        "roles-vocabulary": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "hif-schema": {
          "type": "string"
        },
        "hif-schema-sha256": {
          "const": "639466b7a10de5a734d231d72422f54a5fce4084cb300869012510124c9b2196",
          "x-khg-code": "P-HIF-SCHEMA"
        },
        "hif-schema-doi": {
          "type": "string"
        },
        "khg-profile": {
          "type": "string",
          "pattern": "^khg-hif/1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "x-khg-code": "P-PROFILE"
        },
        "khg-header": {
          "type": "object",
          "required": [
            "kind",
            "format"
          ]
        },
        "khg-schemas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "id",
              "version"
            ]
          }
        },
        "khg-slice": {
          "type": "object"
        }
      },
      "not": {
        "required": [
          "default_attrs"
        ]
      },
      "x-khg-code": "P-METADATA"
    },
    "incidence": {
      "type": "object",
      "required": [
        "attrs"
      ],
      "properties": {
        "edge": {
          "$ref": "#/definitions/khgid"
        },
        "node": {
          "$ref": "#/definitions/khgid"
        },
        "attrs": {
          "type": "object",
          "allOf": [
            {
              "required": [
                "role"
              ],
              "x-khg-code": "P-ROLE"
            },
            {
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "x-khg-code": "P-ROLE"
                },
                "khg-bid": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,64}$"
                },
                "khg-slot": {
                  "enum": [
                    "core",
                    "qualifier",
                    "time",
                    "meta"
                  ]
                },
                "khg-position": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "x-khg-code": "P-INCIDENCE-ATTRS"
            }
          ]
        }
      },
      "not": {
        "required": [
          "weight"
        ]
      }
    },
    "node": {
      "type": "object",
      "required": [
        "attrs"
      ],
      "not": {
        "required": [
          "weight"
        ]
      },
      "properties": {
        "node": {
          "$ref": "#/definitions/khgid"
        },
        "attrs": {
          "type": "object",
          "required": [
            "khg-kind"
          ],
          "properties": {
            "khg-kind": {
              "enum": [
                "entity",
                "literal",
                "hyperedge-ref"
              ],
              "x-khg-code": "P-NODE-KIND"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "khg-kind": {
                    "const": "entity"
                  }
                }
              },
              "then": {
                "required": [
                  "label",
                  "khg-types"
                ],
                "propertyNames": {
                  "enum": [
                    "khg-kind",
                    "label",
                    "khg-types",
                    "khg-aliases",
                    "khg-same-as"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "khg-kind": {
                    "const": "literal"
                  }
                }
              },
              "then": {
                "required": [
                  "label",
                  "khg-literal"
                ],
                "propertyNames": {
                  "enum": [
                    "khg-kind",
                    "label",
                    "khg-literal"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "khg-kind": {
                    "const": "hyperedge-ref"
                  }
                }
              },
              "then": {
                "required": [
                  "khg-ref"
                ],
                "propertyNames": {
                  "enum": [
                    "khg-kind",
                    "khg-ref"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "attrs"
      ],
      "not": {
        "required": [
          "weight"
        ]
      },
      "properties": {
        "edge": {
          "$ref": "#/definitions/khgid"
        },
        "attrs": {
          "type": "object",
          "required": [
            "khg-kind"
          ],
          "properties": {
            "relation": {
              "type": "string",
              "minLength": 1,
              "x-khg-code": "P-RELATION"
            },
            "khg-kind": {
              "enum": [
                "hyperedge",
                "supersession"
              ],
              "x-khg-code": "P-EDGE-KIND"
            },
            "khg-status": {
              "enum": [
                "asserted",
                "disputed",
                "superseded",
                "retracted",
                "goal"
              ],
              "x-khg-code": "P-STATUS"
            }
          },
          "allOf": [
            {
              "required": [
                "relation"
              ],
              "x-khg-code": "P-RELATION"
            },
            {
              "if": {
                "properties": {
                  "khg-kind": {
                    "const": "hyperedge"
                  }
                }
              },
              "then": {
                "required": [
                  "khg-status",
                  "khg-version",
                  "khg-recorded-at",
                  "khg-schema",
                  "khg-rank",
                  "khg-visibility",
                  "khg-arity",
                  "khg-keys"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "khg-kind": {
                    "const": "supersession"
                  }
                }
              },
              "then": {
                "required": [
                  "khg-reason",
                  "khg-evidence"
                ],
                "properties": {
                  "relation": {
                    "const": "khg-supersedes"
                  }
                }
              }
            }
          ],
          "propertyNames": {
            "anyOf": [
              {
                "enum": [
                  "relation"
                ]
              },
              {
                "pattern": "^khg-[a-z][a-z-]*$"
              }
            ]
          }
        }
      }
    }
  }
}