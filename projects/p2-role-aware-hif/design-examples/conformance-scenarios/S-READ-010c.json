{
 "format": "khg-scenario/1.0.0",
 "id": "S-READ-010c",
 "title": "find by a time literal: precision takes part in equality; the calendar does not (capability-limited fixture @fixture[core])",
 "requires": [
  "literal_values",
  "nesting"
 ],
 "schema": "fixture.relation-schema.json",
 "fixture": "fixture.c1.json",
 "given": [
  {
   "load": "@fixture[core]"
  }
 ],
 "when": [
