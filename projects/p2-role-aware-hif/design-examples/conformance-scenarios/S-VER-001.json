{
 "format": "khg-scenario/1.0.0",
 "id": "S-VER-001",
 "title": "each write makes a version; get(as_at) returns the older one",
 "requires": [
  "atomic_writes",
  "literal_values",
  "transaction_time",
  "valid_time"
 ],
 "schema": "fixture.relation-schema.json",
 "fixture": "fixture.c1.json",
 "given": [
  {
   "put": [
    "@entities"
   ],
   "at": "2026-10-01T00:00:01Z"
  },
  {
   "put": [
    {
     "@": "f:king-13",
     "drop_bindings": [
      "b4"
     ]
    }
   ],
   "at": "2026-10-01T00:00:02Z"
  }
 ],
 "when": [
  {
   "op": "apply",
   "args": {
    "event": {
     "op": "end_validity",
     "target": "f:king-13",
     "end": {
      "literal": {
       "datatype": "time",
       "time": "+1643-05-14T00:00:00Z",
       "precision": 11
      }
     },
     "evidence": [
      {
       "id": "e9",
       "type": "curated",
       "mode": "manual",
       "source": {
        "doc_id": "doc:scenario"
       }
      }
     ]
    }
   },
   "then": {
    "select": "receipt.records",
    "equals": [
     [
      "f:king-13",
      2,
      "versioned"
     ]
    ]
   },
   "at": "2026-10-01T00:00:03Z"
  },
  {
   "op": "get",
   "args": {
    "id": "f:king-13",
    "as_at": "2026-10-01T00:00:02Z"
   },
   "then": {
    "select": "version",
    "equals": 1
   }
  },
  {
   "op": "get",
   "args": {
    "id": "f:king-13"
   },
   "then": {
    "select": "version",
    "equals": 2
   }
  },
  {
   "op": "history",
   "args": {
    "id": "f:king-13"
   },
   "then": {
    "select": "versions",
    "equals": [
     1,
     2
    ]
   }
  }
 ],
 "precedent": [
  "A C2-03 passed",
  "C S-PUT-002 passed",
  "B S010"
 ]
}
