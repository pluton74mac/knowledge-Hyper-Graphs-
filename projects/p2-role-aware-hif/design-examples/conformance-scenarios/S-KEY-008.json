{
 "format": "khg-scenario/1.0.0",
 "id": "S-KEY-008",
 "title": "dispute: one transition writes the new fact, both statuses and the khg:disputes record",
 "requires": [
  "atomic_writes",
  "key_constraint"
 ],
 "schema": "fixture.relation-schema.json",
 "fixture": "fixture.c1.json",
 "given": [
  {
   "put": [
    "@entities",
    "@f:born-skłodowska-warszawa"
   ]
  }
 ],
 "when": [
  {
   "op": "apply",
   "args": {
    "event": {
     "op": "transition",
     "targets": [
      "f:born-skłodowska-warszawa"
     ],
     "to": "disputed",
     "records": [
      {
       "@": "f:born-skłodowska-kraków",
       "set": {
        "status": "asserted"
       },
       "drop": [
        "status_ref"
       ]
      }
     ],
     "id": "m:dis-1",
     "reason": "key_conflict",
     "evidence": [
      {
       "id": "e9",
       "type": "curated",
       "mode": "manual",
       "source": {
        "doc_id": "doc:scenario"
       }
      }
     ]
    }
   },
   "then": {
    "select": "receipt.records",
    "equals": [
     [
      "f:born-skłodowska-kraków",
      1,
      "created"
     ],
     [
      "f:born-skłodowska-warszawa",
      2,
      "versioned"
     ],
     [
      "m:dis-1",
      1,
      "created"
     ]
    ]
   }
  },
  {
   "op": "get",
   "args": {
    "id": "f:born-skłodowska-kraków"
   },
   "then": {
    "select": "status_ref",
    "equals": "m:dis-1"
   }
  },
  {
   "op": "find_by_key",
   "args": {
    "relation": "born_in",
    "key": [
     {
      "role": "person",
      "value": {
       "entity": "ex:Maria_Skłodowska"
      }
     }
    ]
   },
   "then": {
    "select": "ids",
    "equals": []
   }
  },
  {
   "op": "find_by_key",
   "args": {
    "relation": "born_in",
    "key": [
     {
      "role": "person",
      "value": {
       "entity": "ex:Maria_Skłodowska"
      }
     }
    ],
    "where": {
     "status": [
      "disputed"
     ]
    }
   },
   "then": {
    "select": "ids",
    "equals": [
     "f:born-skłodowska-kraków",
     "f:born-skłodowska-warszawa"
    ]
   }
  }
 ],
 "precedent": [
  "B S045",
  "C S-LIFE (transition)",
  "critique SEM-10"
 ]
}
