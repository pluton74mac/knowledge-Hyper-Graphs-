{
 "format": "khg-scenario/1.0.0",
 "id": "S-TIME-007",
 "title": "a Julian date is compared on the proleptic Gregorian line",
 "requires": [
  "literal_values",
  "valid_time"
 ],
 "schema": "fixture.relation-schema.json",
 "fixture": "fixture.c1.json",
 "given": [
  {
   "put": [
    "@entities",
    {
     "@": "f:king-13",
     "set_binding": {
      "b4": {
       "literal": {
        "datatype": "time",
        "time": "+1643-05-04T00:00:00Z",
        "precision": 11,
        "calendar": "julian"
       }
      }
     }
    }
   ]
  }
 ],
 "when": [
  {
   "op": "incident",
   "args": {
    "node": "ex:KingOfFrance",
    "where": {
     "as_of": "+1643-05-13T00:00:00Z"
    }
   },
   "then": {
    "select": "ids",
    "equals": [
     "f:king-13"
    ]
   }
  },
  {
   "op": "incident",
   "args": {
    "node": "ex:KingOfFrance",
    "where": {
     "as_of": "+1643-05-14T12:00:00Z"
    }
   },
   "then": {
    "select": "ids",
    "equals": []
   }
  }
 ],
 "precedent": [
  "graft U10 (calendar field)"
 ]
}
