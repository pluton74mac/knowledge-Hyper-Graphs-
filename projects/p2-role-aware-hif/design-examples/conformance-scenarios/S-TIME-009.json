{
 "format": "khg-scenario/1.0.0",
 "id": "S-TIME-009",
 "title": "a somevalue end (ended, date unknown) has no definite validity after the start window",
 "requires": [
  "literal_values",
  "special_values",
  "valid_time"
 ],
 "schema": "fixture.relation-schema.json",
 "fixture": "fixture.c1.json",
 "given": [
  {
   "put": [
    "@entities",
    {
     "@": "f:king-13",
     "set_binding": {
      "b4": {
       "special": "somevalue"
      }
     }
    }
   ]
  }
 ],
 "when": [
  {
   "op": "incident",
   "args": {
    "node": "ex:KingOfFrance",
    "where": {
     "as_of": "+1620-01-01T00:00:00Z"
    }
   },
   "then": {
    "select": "ids",
    "equals": []
   }
  },
  {
   "op": "incident",
   "args": {
    "node": "ex:KingOfFrance",
    "where": {
     "as_of": "+1620-01-01T00:00:00Z",
     "valid_mode": "possible"
    }
   },
   "then": {
    "select": "ids",
    "equals": [
     "f:king-13"
    ]
   }
  },
  {
   "op": "get",
   "args": {
    "id": "f:king-13"
   },
   "then": {
    "select": "derived.valid_time.kind",
    "equals": "ended"
   }
  },
  {
   "op": "get",
   "args": {
    "id": "f:king-13"
   },
   "then": {
    "select": "derived.valid_time.definite",
    "equals": null
   }
  }
 ],
 "precedent": [
  "critique SEM-01"
 ]
}
