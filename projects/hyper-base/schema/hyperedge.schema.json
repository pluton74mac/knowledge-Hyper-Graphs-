{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pluton74mac/hyper-base/schema/hyperedge.schema.json",
  "title": "hyper-base hyperedge record (v0)",
  "type": "object",
  "required": ["id", "relation", "bindings", "status", "created_by", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id":       {"type": "string", "pattern": "^h:[a-z0-9][a-z0-9-]*$"},
    "relation": {"type": "string", "description": "A relation type declared in relation-types.yaml"},
    "bindings": {
      "type": "object",
      "description": "role -> node id. A goal hyperedge may bind a role to null to mark it unbound.",
      "additionalProperties": {"type": ["string", "null"]}
    },
    "status":   {"enum": ["goal", "candidate", "disputed", "accepted", "superseded", "retracted", "rejected"]},
    "evidence": {"type": "array", "items": {"type": "string", "pattern": "^ev:"}, "default": []},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1, "description": "Set by the linter, never by the writer"},
    "created_by": {"type": "string", "pattern": "^run:", "description": "agent-run node id"},
    "created_at": {"type": "string", "format": "date-time"},
    "superseded_by": {"type": "string", "pattern": "^h:"},
    "valid_from": {"type": "string", "format": "date"},
    "valid_to":   {"type": "string", "format": "date"},
    "gloss":    {"type": "string", "maxLength": 200, "description": "One line for humans and for the walker's candidate list"},
    "lint":     {
      "type": "array",
      "description": "Append-only log of linter actions on this record",
      "items": {
        "type": "object",
        "required": ["at", "rule", "action"],
        "properties": {
          "at":     {"type": "string", "format": "date-time"},
          "rule":   {"type": "string"},
          "action": {"enum": ["accept", "merge", "supersede", "reject", "escalate", "dispute"]},
          "note":   {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "superseded"}}},
      "then": {"required": ["superseded_by"]}
    },
    {
      "if": {"properties": {"status": {"enum": ["accepted", "superseded", "disputed"]}}},
      "then": {"properties": {"evidence": {"minItems": 1}}}
    }
  ]
}
